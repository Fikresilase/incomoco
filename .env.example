# Copy to .env and fill in OPENROUTER_API_KEY. Never commit .env.

# --- AI gateway (OpenRouter) ---
# AI_PROVIDER=fake runs everything offline with deterministic stand-ins (no key needed; answers are canned).
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-3.5-flash-lite
TTS_MODEL=google/gemini-3.8-flash-lite-tts
TTS_VOICE=Kore
EMBEDDING_MODEL=google/gemini-embedding-2
RERANK_MODEL=cohere/rerank-4-fast

# --- Speech-to-text biasing ---
# Instruction language for transcription: am (Amharic) or en (English)
STT_PROMPT_LANG=am
# Comma-separated terms, Amharic=English spelling (a bare term is used as-is)
STT_VOCABULARY=ኢንኮሞኮ=Inkomoko
# Recent conversation turns given to the transcriber as context
STT_CONTEXT_TURNS=4

# --- RAG tuning ---
HYBRID_ALPHA=0.5
RETRIEVAL_TOP_K=30
RERANK_TOP_N=8
RERANK_MIN_SCORE=0.05
LOW_CONFIDENCE_SCORE=0.3
HISTORY_TURNS=6
CHUNK_MIN_TOKENS=450
CHUNK_MAX_TOKENS=1200
CONTEXTUAL_RETRIEVAL=true
PDF_PAGES_PER_BATCH=12
MAX_UPLOAD_MB=25

# --- Demo admin (DEMO ONLY: change before any shared/hosted deployment) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-to-a-long-random-string

# --- Infrastructure (defaults match docker-compose.yml) ---
POSTGRES_USER=inkomoko
POSTGRES_PASSWORD=inkomoko
POSTGRES_DB=inkomoko
MINIO_ROOT_USER=inkomoko
MINIO_ROOT_PASSWORD=inkomoko-secret
MINIO_BUCKET=documents

# --- Host ports (change any that clash with other software on your machine) ---
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5433
WEAVIATE_PORT=8081
WEAVIATE_GRPC_PORT=50052
MINIO_PORT=9010
MINIO_CONSOLE_PORT=9011
# Derived automatically from the ports above; override only if needed:
# CORS_ORIGINS=http://localhost:3000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Web UI ---
# Show source cards and [n] citation badges under answers (sources are always stored by the backend)
NEXT_PUBLIC_SHOW_SOURCES=false
