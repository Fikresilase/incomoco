ext><text id='cashStatus' x='1160' y='645' font-size='18' fill='#E2E8F0' text-anchor='middle' opacity='0.8'>ደንበኛው እስካልከፈለ ገንዘብ የለም</text></g><g id='creditInvoice' opacity='0'><g transform='translate(0, 0)'><rect x='280' y='0' width='320' height='100' rx='14' fill='#19153e' stroke='#F4D35E' stroke-width='2' filter='url(#glowYellow)'/><text x='440' y='38' font-size='18' font-weight='700' fill='#F4D35E' text-anchor='middle'>የብድር ሽያጭ ደረሰኝ</text><text x='440' y='68' font-size='24' font-weight='700' fill='#F5F4FE' text-anchor='middle'>+50,000 ብር</text><text x='440' y='88' font-size='14' fill='#58C4DD' text-anchor='middle'>ክፍያው ወደፊት ይፈጸማል</text></g></g><g id='rentBill' opacity='0'><g transform='translate(0, 0)'><rect x='1000' y='0' width='320' height='110' rx='14' fill='#2A1218' stroke='#FFA07A' stroke-width='2' filter='url(#glowAlert)'/><text x='1160' y='35' font-size='18' font-weight='700' fill='#FFA07A' text-anchor='middle'>⚠️ አስቸኳይ የኪራይ ክፍያ</text><text x='1160' y='68' font-size='26' font-weight='700' fill='#FFFFFF' text-anchor='middle'>-30,000 ብር</text><text x='1160' y='92' font-size='14' fill='#FFA07A' text-anchor='middle'>ዛሬ የሚከፈል የቤት ኪራይ</text></g></g><g id='alertBanner' opacity='0'><rect x='960' y='575' width='400' height='46' rx='10' fill='#FFA07A' fill-opacity='0.18' stroke='#FFA07A' stroke-width='1.5'/><text x='1160' y='604' font-size='17' font-weight='700' fill='#FFA07A' text-anchor='middle'>እጥረት: ሂሳቡን ለመክፈል ጥሬ ገንዘብ የለም!</text></g><g id='summaryBanner' opacity='0'><rect x='260' y='730' width='1080' height='75' rx='16' fill='#19153e' fill-opacity='0.9' stroke='#58C4DD' stroke-width='1'/><text id='summaryLine1' x='800' y='760' font-size='20' font-weight='700' fill='#F4D35E' text-anchor='middle'>ትርፍ በወረቀት ላይ ብቻ ሊኖር ይችላል፤ ንግድ ግን የሚንቀሳቀሰው በጥሬ ገንዘብ ነው!</text><text id='summaryLine2' x='800' y='788' font-size='16' fill='#F5F4FE' text-anchor='middle'>ሁልጊዜ ትርፍዎን ብቻ ሳይሆን በእጅዎ ያለውን ጥሬ ገንዘብ (Cash Flow) በንቃት ይከታተሉ</text></g></svg></div><script>const clamp=(val,min,max)=>Math.min(Math.max(val,min),max);const invoice=document.getElementById('creditInvoice');const rentBill=document.getElementById('rentBill');const profitFill=document.getElementById('profitFill');const profitCounter=document.getElementById('profitCounter');const profitStatus=document.getElementById('profitStatus');const cashCounter=document.getElementById('cashCounter');const cashJarBorder=document.getElementById('cashJarBorder');const cashBadge=document.getElementById('cashBadge');const cashBadgeText=document.getElementById('cashBadgeText');const alertBanner=document.getElementById('alertBanner');const summaryBanner=document.getElementById('summaryBanner');const emptyRing=document.getElementById('emptyRing');const emptyIcon=document.getElementById('emptyIcon');window.renderBestieFrame=function(p){const p1=clamp(p/0.3,0,1);if(p<0.35){invoice.setAttribute('opacity',p1);const y=120+p1*340;invoice.setAttribute('transform','translate(0,'+y+')');}else{invoice.setAttribute('opacity',Math.max(0,1-(p-0.35)/0.1));invoice.setAttribute('transform','translate(0,460)');}const pProfit=clamp((p-0.15)/0.25,0,1);const profitVal=Math.round(pProfit*50000);profitCounter.textContent='+'+profitVal.toLocaleString('en-US')+' ብር';const fillHeight=pProfit*180;profitFill.setAttribute('y',650-fillHeight);profitFill.setAttribute('height',fillHeight);if(pProfit>0.8){profitStatus.setAttribute('opacity',clamp((pProfit-0.8)/0.2,0,1));}else{profitStatus.setAttribute('opacity',0);}const pBill=clamp((p-0.45)/0.25,0,1);if(p>=0.45){rentBill.setAttribute('opacity',pBill);const yRent=120+pBill*290;rentBill.setAttribute('transform','translate(0,'+yRent+')');}else{rentBill.setAttribute('opacity',0);}const pDeficit=clamp((p-0.65)/0.2,0,1);alertBanner.setAttribute('opacity',pDeficit);if(pDeficit>0){cashJarBorder.setAttribute('stroke','#FFA07A');cashJarBorder.setAttribute('stroke-width','2.5');cashBadge.setAttribute('stroke','#FFA07A');cashBadge.setAttribute('fill','#FFA07A');cashBadge.setAttribute('fill-opacity','0.2');cashBadgeText.setAttribute('fill','#FFA07A');cashCounter.setAttribute('fill','#FFA07A');emptyRing.setAttribute('stroke','#FFA07A');emptyRing.setAttribute('stroke-width','2.5');emptyIcon.setAttribute('fill','#FFA07A');emptyIcon.textContent='0 ብር!';}else{cashJarBorder.setAttribute('stroke','#1DE8B0');cashJarBorder.setAttribute('stroke-width','1.5');cashBadge.setAttribute('stroke','#1DE8B0');cashBadge.setAttribute('fill','#1DE8B0');cashBadge.setAttribute('fill-opacity','0.15');cashBadgeText.setAttribute('fill','#1DE8B0');cashCounter.setAttribute('fill','#1DE8B0');emptyRing.setAttribute('stroke','#58C4DD');emptyRing.setAttribute('stroke-width','2');emptyIcon.setAttribute('fill','#A0AEC0');emptyIcon.textContent='ባዶ';}const pSummary=clamp((p-0.78)/0.2,0,1);summaryBanner.setAttribute('opacity',pSummary);};window.renderBestieFrame(0);</script></body></html>"
